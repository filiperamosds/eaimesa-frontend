# Copie para .env na raiz. Nunca commite valores reais.

# URL pública deste front (cookies / CORS da API usam APP_URL no outro repo)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Fastify (repo filiperamosds/eaimesa). O Next faz proxy de /v1 para cá.
API_URL=http://localhost:4000

# Browser: vazio = mesma origem (rewrite /v1). Só preencha se o JS for chamar a API direto.
# NEXT_PUBLIC_API_URL=
