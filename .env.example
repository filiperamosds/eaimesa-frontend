# Copie para .env na raiz. Nunca commite valores reais.
# GitHub Actions: Settings → Secrets and variables → Actions.
# Staging (develop): NEXT_PUBLIC_APP_URL, NEXT_PUBLIC_API_URL, pasta DEV no servidor
# Produção (main): NEXT_PUBLIC_APP_URL_PRD, NEXT_PUBLIC_API_URL_PRD, pasta PRD
# Deploy: SSH_PRIVATE_KEY + REMOTE_HOST + REMOTE_USER (+ REMOTE_PORT) — iguais ao repo da API.

# URL pública deste front (cookies / CORS da API usam APP_URL no outro repo)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Laravel (browser e build). Sem proxy /v1 — o estático chama a API direto.
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000

# Slugs gerados no `pnpm build` (além de __venue). Outros bares usam .htaccess.
# STATIC_SLUGS=seu-estabelecimento
