# Copie para .env na raiz. Nunca commite valores reais.

# URL pública deste front (cookies / CORS da API usam APP_URL no outro repo)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Laravel (browser e build). Sem proxy /v1 — o estático chama a API direto.
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000

# Slugs gerados no `pnpm build` (além de __venue). Outros bares usam .htaccess.
# STATIC_SLUGS=bar-do-tiao,cafe-da-lina
