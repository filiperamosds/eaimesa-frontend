Options -MultiViews
DirectorySlash Off

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # QR /{slug}/c/{token}: a pasta /c/ existe no export. Sem esta regra ANTES do -d,
  # o Apache trata o token como arquivo e a Hostinger devolve 404 próprio.
  RewriteCond %{DOCUMENT_ROOT}/$1/c/index.html -f
  RewriteRule ^([^/]+)/c/([^/]+)/?$ /$1/c/index.html [L]

  RewriteCond %{DOCUMENT_ROOT}/__venue/c/index.html -f
  RewriteRule ^([^/]+)/c/([^/]+)/?$ /__venue/c/index.html [L]

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  RewriteCond %{DOCUMENT_ROOT}/$1/$2/index.html -f
  RewriteRule ^([^/]+)/(entrar|comanda|bem-vindo)/?$ /$1/$2/index.html [L]

  RewriteCond %{DOCUMENT_ROOT}/__venue/$2/index.html -f
  RewriteRule ^([^/]+)/(entrar|comanda|bem-vindo)/?$ /__venue/$2/index.html [L]

  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^([^/]+)/?$ /$1/index.html [L]

  RewriteCond %{DOCUMENT_ROOT}/__venue/index.html -f
  RewriteRule ^([^/]+)/?$ /__venue/index.html [L]
</IfModule>

ErrorDocument 404 /404.html
